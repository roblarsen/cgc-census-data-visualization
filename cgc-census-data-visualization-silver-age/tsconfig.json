{
  "compilerOptions": {
    "target": "ES6",
    "module": "es6",
    "jsx": "react",
    "allowJs": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./docs",
    "noImplicitAny": false
  },
  "include": ["scripts/**/*"],
  "paths": ["node_modules/**/*"]
}
